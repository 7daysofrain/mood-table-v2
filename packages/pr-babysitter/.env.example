# Configuración del PR Babysitter (change pr-tracking). Copiar a `.env` (no se commitea) y rellenar.
# Los secretos no se escriben en ningún otro sitio.

# PAT fine-grained de GitHub del mantenedor: solo el repo mood-table-v2, con Metadata en lectura e
# Issues y Pull requests en escritura, que GitHub exige los dos para comentar en una PR (la petición
# de revisión, change pr-review-request). Sin Contents: no puede subir commits ni integrar.
GITHUB_TOKEN=
# Login de GitHub del mantenedor, dueño de GITHUB_TOKEN: solo se siguen sus PR, y solo cuentan las
# peticiones de revisión escritas con su cuenta.
GITHUB_MAINTAINER=
# Cuenta de GitHub del revisor: solo cuentan sus comentarios. Por defecto, la de Codex.
GITHUB_REVIEWER=

# App OAuth «PR Babysitter» de Linear (actor=app, client credentials, scopes read y comments:create).
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# URL del perfil del mantenedor en Linear (https://linear.app/<workspace>/profiles/<usuario>): así se
# le menciona en cada aviso.
LINEAR_MAINTAINER_PROFILE_URL=
# ID (UUID) del issue buzón, para los avisos sin tarea y los del propio sistema.
LINEAR_INBOX_ISSUE_ID=

# Segundos entre vueltas. Por defecto, 60.
POLL_INTERVAL_SECONDS=
# Minutos que se esperan las comprobaciones, desde que se ve un push, y la revisión, desde que pasan
# las comprobaciones. Por defecto, 30.
TRACKING_TIMEOUT_MINUTES=

# Modelo de decisión del triaje en modo sombra (change pr-shadow-triage): Clef en la nube de Ollama,
# de pago por uso. Clave de la cuenta de Ollama, obligatoria. El presupuesto mensual se pone en la
# cuenta (créditos prepagados, sin recarga automática), no aquí.
DECISION_MODEL_API_KEY=
# Proveedor del protocolo de decisión (POST /v1/systemone), sin la ruta. Por defecto,
# https://ollama.com; para Clef en local, http://localhost:11434.
DECISION_MODEL_BASE_URL=
# Modelo, fijado por su id: los umbrales no valen para otro. Por defecto, clef:27b.
DECISION_MODEL=
# Dólares por millón de tokens de entrada (la salida es gratis). Por defecto, 0.24; en local, 0.
DECISION_MODEL_INPUT_PRICE_PER_MTOK=
# Probabilidad a partir de la que un hallazgo es real; con su complemento o menos, no aplica; entre
# las dos, exige criterio. Mayor que 0.5 y como mucho 1. Por defecto, 0.8.
TRIAGE_THRESHOLD=
# Tope de gasto del triaje de cada PR, en dólares. Por defecto, 0.05.
TRIAGE_BUDGET_USD=

# Trazas del grafo en LangSmith (MOO-92, D76). Las lee la librería `langsmith`, no la configuración
# del PR Babysitter. Apagadas aquí; en el `.env` de casa, `true`. Qué datos salen: README §2.5.
LANGSMITH_TRACING=false
# API key personal de LangSmith (plan gratuito, sin tarjeta).
LANGSMITH_API_KEY=
# Proyecto de LangSmith donde se ven las ejecuciones; cada PR es un hilo.
LANGSMITH_PROJECT=pr-babysitter
# Solo si la cuenta es de la región UE: LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
