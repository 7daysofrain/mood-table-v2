# Secretos y ajustes del fixer, el servicio que arregla (change pr-fixer, D128-D130). Copiar a
# `fixer.env`, que no se commitea. Son aparte del `.env` del babysitter: el fixer no ve el PAT, ni
# Linear, ni Ollama.

# Clave de la API de Anthropic, para el Claude Agent SDK (la suscripción de claude.ai no vale).
ANTHROPIC_API_KEY=

# La GitHub App del PR Babysitter (D128): su client ID y la ruta de su clave privada en PEM, que se
# guarda fuera del repo. Solo sube a las ramas de las PR: el ruleset «solo el mantenedor integra» le
# impide integrar o actualizar main. En el compose, la clave es el secreto `fixer-app-key`, que sale de
# ~/.config/pr-babysitter/app-private-key.pem, y FIXER_APP_PRIVATE_KEY_FILE lo pone el compose; fuera
# de él (`pnpm fixer`), la ruta de la clave.
FIXER_APP_CLIENT_ID=
FIXER_APP_PRIVATE_KEY_FILE=
# El repo, como owner/name.
FIXER_REPOSITORY=7daysofrain/mood-table-v2

# Opcionales, con su valor por defecto:
# El modelo del agente. Por defecto, claude-sonnet-5-5.
FIXER_MODEL=
# Tope de turnos del agente por hallazgo. Por defecto, 40 (asumido: se fija con la prueba a mano).
FIXER_MAX_TURNS=
# Lo más que tarda pnpm install, lint, typecheck o test en el clon, en minutos. Por defecto, 15.
FIXER_COMMAND_TIMEOUT_MINUTES=
# Dónde guarda la cola y lo gastado. Por defecto, /data/fixer.sqlite (el volumen del compose).
FIXER_DB_PATH=
# El puerto en la red interna. Por defecto, 8080 (el compose da http://fixer:8080 al babysitter).
FIXER_PORT=
