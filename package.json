{
  "name": "mood-table",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node tooling/dev/prepare-local-config.ts && pnpm --parallel --filter @moodtable/engine --filter @moodtable/panel dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @moodtable/e2e test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@fission-ai/openspec": "1.14.3",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-boundaries": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "globals": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
